{
  "name": "sheddesign",
  "version": "0.1.0",
  "description": "AI-powered garden shed design assistant",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install-all": "npm install",
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "build": "npm --workspaces run build",
    "test": "npm --workspaces run test"
  },
  "keywords": [
    "garden",
    "design",
    "ai",
    "3d"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
